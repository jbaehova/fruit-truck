{
  "productName": "OpenGen UI E2E",
  "mainBinaryName": "OpenGen UI E2E",
  "identifier": "ui.opengen.desktop.e2e",
  "app": {
    "windows": [
      {
        "title": "OpenGen UI E2E",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/generated/**",
          "$HOME/.open-gen-ui/assets/**",
          "$HOME/.open-gen-ui/generated/**",
          "$HOME/.open-gen-ui-e2e/assets/**",
          "$HOME/.open-gen-ui-e2e/generated/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": false
  }
}
