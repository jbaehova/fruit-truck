{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Oppa Gen",
  "mainBinaryName": "Oppa Gen",
  "version": "0.3.0",
  "identifier": "ui.oppagen.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Oppa Gen",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://openrouter.ai; img-src 'self' asset: http://asset.localhost blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/generated/**",
          "$HOME/.oppa-gen/assets/**",
          "$HOME/.oppa-gen/generated/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.icns"],
    "macOS": {
      "bundleName": "Oppa Gen",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzRUY3OTU5M0U3OEZFMgpSV1RpaitlVGxmYytDd1Z2d0oybVNRT1lWa3FkUkt1VnZCNmtzdWt2UDdpbDU1S0lBMlhMcFp5cgo=",
      "endpoints": [
        "https://github.com/jbaehova/oppa-gen/releases/latest/download/latest.json"
      ]
    }
  }
}
