{
  "name": "fruit-truck",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:unit": "bash scripts/prepare-core-sidecar.sh && node --test 'src/**/*.test.ts' 'scripts/**/*.test.mjs'",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc -b && oxlint && node scripts/check-release-contract.mjs",
    "tauri:dev": "bash scripts/prepare-core-sidecar.sh && tauri dev",
    "mcp": "node scripts/mcp-server.ts",
    "build:e2e:desktop": "bash scripts/prepare-core-sidecar.sh && tauri build --debug --bundles app --config src-tauri/tauri.e2e.conf.json",
    "bundle:mac": "bash scripts/prepare-core-sidecar.sh && tauri build --bundles dmg",
    "bundle:mac:universal": "bash scripts/build-macos-universal.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
